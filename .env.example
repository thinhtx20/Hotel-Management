PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/hotel_db?schema=public"
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis & Elastic
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
ELASTICSEARCH_NODE="http://localhost:9200"

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hotel Management <noreply@hotelmanagement.vn>"

# OTP mặc định (Dev / Test)
DEFAULT_OTP=123456

# Mỗi tài khoản khách hàng (CUSTOMER) chỉ đăng nhập được trên 1 thiết bị
#   kick_old  (mặc định): đăng nhập máy mới -> tự động đăng xuất máy cũ
#   block_new           : giữ máy cũ -> từ chối đăng nhập ở máy mới
SINGLE_DEVICE_MODE=kick_old

# Cloudinary Storage Configuration (Khuyến nghị)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Supabase Storage Configuration (Tùy chọn dự phòng)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_BUCKET="hotel-images"

# Luong SSE cap nhat danh sach tai khoan (GET /api/v1/users/stream)
# Chu ky quet CSDL de bat tai khoan tao boi instance khac (ms). Dat 0 de tat.
USER_EVENTS_POLL_MS=15000
