PORT=3000
NODE_ENV=development

# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/hotel_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-hotel-jwt-key-2026-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis Configuration (PA1)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Elasticsearch Configuration (PA1)
ELASTICSEARCH_NODE="http://localhost:9200"

# SMTP Mail Configuration (Quên mật khẩu & Thông báo)
# Điền tài khoản SMTP Gmail/SendGrid/v.v. để gửi mail thực tế, hoặc để trống để sử dụng Console Dev Mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hotel Management <noreply@hotelmanagement.vn>"

# OTP mặc định cho môi trường phát triển & kiểm thử
DEFAULT_OTP=123456
