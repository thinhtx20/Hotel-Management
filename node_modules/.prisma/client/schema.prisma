// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  CASHIER
  CUSTOMER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings       Booking[]
  issuedInvoices Invoice[]

  @@map("users")
}

model RoomType {
  id               String   @id @default(uuid())
  name             String   @unique
  code             String   @unique
  description      String?
  basePrice        Float
  capacityAdults   Int      @default(2)
  capacityChildren Int      @default(1)
  sizeSqM          Float?
  amenities        String[]
  images           String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms Room[]

  @@map("room_types")
}

model Room {
  id         String     @id @default(uuid())
  roomNumber String     @unique
  floor      Int
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  status     RoomStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings Booking[]

  @@map("rooms")
}

model Booking {
  id              String        @id @default(uuid())
  bookingCode     String        @unique
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  roomId          String
  room            Room          @relation(fields: [roomId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  guestCount      Int           @default(1)
  totalAmount     Float
  depositAmount   Float         @default(0)
  status          BookingStatus @default(PENDING)
  specialRequests String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice       Invoice?
  serviceOrders ExtraServiceOrder[]

  @@map("bookings")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceCode    String        @unique
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomAmount     Float
  servicesAmount Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  finalAmount    Float
  paidAmount     Float         @default(0)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(UNPAID)
  issuedById     String?
  issuedBy       User?         @relation(fields: [issuedById], references: [id])
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("invoices")
}

model ExtraServiceOrder {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceName String
  unitPrice   Float
  quantity    Int      @default(1)
  totalPrice  Float
  createdAt   DateTime @default(now())

  @@map("extra_service_orders")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  otp       String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}
