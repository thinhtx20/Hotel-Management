// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  CUSTOMER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
  PENDING_APPROVAL
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

/// Một dòng trên sổ thu tiền là khoản thu, tiền cọc hay khoản hoàn trả.
/// DEPOSIT được tách riêng khỏi PAYMENT để lần duyệt đơn sau ghi đè đúng dòng
/// tiền cọc cũ thay vì cộng dồn thành hai lần thu.
enum PaymentEntryType {
  PAYMENT
  DEPOSIT
  REFUND
}

/// Vòng đời một dòng thu tiền.
/// PENDING: khách bấm thanh toán trên app, tiền CHƯA vào két, chờ thu ngân đối chiếu.
/// CONFIRMED: thu ngân xác nhận đã nhận tiền, khoản này mới được cộng vào paidAmount.
/// REJECTED: thu ngân không tìm thấy giao dịch, khoản này không bao giờ được tính tiền.
enum PaymentEntryStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  fullName       String
  phone          String?
  avatar         String?
  role           Role      @default(CUSTOMER)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Chốt phiên đăng nhập: tài khoản khách hàng chỉ được đăng nhập trên 1 thiết bị.
  // activeSessionId là mã phiên duy nhất đang có hiệu lực (khớp với `sid` trong JWT).
  activeSessionId String?
  activeDevice    String?
  lastLoginAt     DateTime?

  bookings          Booking[]
  issuedInvoices    Invoice[]
  confirmedBookings Booking[] @relation("BookingConfirmedBy")
  cancelledBookings Booking[] @relation("BookingCancelledBy")
  serviceRequests   ExtraServiceOrder[] @relation("ServiceRequestedBy")
  createdPayments   Payment[] @relation("PaymentCreatedBy")
  confirmedPayments Payment[] @relation("PaymentConfirmedBy")

  @@map("users")
}

model RoomType {
  id               String   @id @default(uuid())
  name             String   @unique
  code             String   @unique
  description      String?
  basePrice        Float
  capacityAdults   Int      @default(2)
  capacityChildren Int      @default(1)
  sizeSqM          Float?
  amenities        String[]
  images           String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms            Room[]

  @@map("room_types")
}

model Room {
  id         String     @id @default(uuid())
  roomNumber String     @unique
  floor      Int
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  status     RoomStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings   Booking[]

  @@map("rooms")
}

model Booking {
  id              String             @id @default(uuid())
  bookingCode     String             @unique
  customerId      String
  customer        User               @relation(fields: [customerId], references: [id])
  roomId          String
  room            Room               @relation(fields: [roomId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  guestCount      Int                @default(1)
  totalAmount     Float
  depositAmount   Float              @default(0)
  status          BookingStatus      @default(PENDING)
  specialRequests String?

  // Dấu vết xác nhận đơn (PENDING -> CONFIRMED)
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?           @relation("BookingConfirmedBy", fields: [confirmedById], references: [id])
  confirmationNote   String?

  // Dấu vết hủy / từ chối đơn (-> CANCELLED)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?           @relation("BookingCancelledBy", fields: [cancelledById], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  invoice         Invoice?
  serviceOrders   ExtraServiceOrder[]

  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@map("bookings")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceCode    String        @unique
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomAmount     Float
  servicesAmount Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  finalAmount    Float
  paidAmount     Float         @default(0)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(UNPAID)
  issuedById     String?
  issuedBy       User?         @relation(fields: [issuedById], references: [id])
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       Payment[]

  @@map("invoices")
}

/// Sổ thu tiền chi tiết của hóa đơn.
///
/// `Invoice.paidAmount` KHÔNG còn được cộng/trừ thủ công ở từng chỗ nữa mà luôn
/// được tính lại bằng tổng các dòng CONFIRMED của bảng này (thu cộng, hoàn trừ).
/// Nhờ vậy màn "Hóa đơn của tôi" hiển thị đúng từng lần khách trả, và số
/// "còn thiếu" của thu ngân lúc check-out luôn khớp với tiền thực tế đã vào két.
model Payment {
  id             String             @id @default(uuid())
  invoiceId      String
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Float
  method         PaymentMethod      @default(CASH)
  type           PaymentEntryType   @default(PAYMENT)
  status         PaymentEntryStatus @default(CONFIRMED)

  /// Mã giao dịch khách nhập khi chuyển khoản, để thu ngân đối chiếu sao kê.
  reference      String?
  note           String?

  /// Người tạo dòng thu: khách hàng (yêu cầu thanh toán) hoặc thu ngân (thu tại quầy).
  createdById    String?
  createdBy      User?              @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  /// Thu ngân xác nhận đã nhận được tiền.
  confirmedById  String?
  confirmedBy    User?              @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt    DateTime?
  rejectedReason String?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([confirmedAt])
  @@map("payments")
}

model ExtraServiceOrder {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceName   String
  unitPrice     Float
  quantity      Int      @default(1)
  totalPrice    Float
  status        String   @default("CONFIRMED") // REQUESTED | CONFIRMED | REJECTED
  requestedById String?
  requestedBy   User?    @relation("ServiceRequestedBy", fields: [requestedById], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@map("extra_service_orders")
}

model HotelService {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String   // FOOD_BEVERAGE | WELLNESS | TRANSPORT | CONVENIENCE | ROOM_SERVICE
  description String?
  unitPrice   Float
  unit        String   @default("lần")
  icon        String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hotel_services")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  otp       String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}
